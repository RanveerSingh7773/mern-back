# Server Configuration
PORT=5000

# MongoDB Connection String (keep this secret! Never commit actual credentials to git)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lakshaura?retryWrites=true&w=majority

# JWT Secret for authentication tokens (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Client URL for CORS (optional)
CLIENT_URL=http://localhost:5173
